# ==============================================================================
# NYRA AI — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION URL & HOSTING
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION & CLOUD DATABASE
# ------------------------------------------------------------------------------
# Get these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Service role key for admin-level operations (NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. AI FOUNDATION PROVIDERS (Configure at least one)
# ------------------------------------------------------------------------------
# Groq API Key (Default recommended provider for ultra-fast Llama & Qwen models)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (For GPT-4o, GPT-4o Mini, and o1 models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (For Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (For Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (For DeepSeek R1 & DeepSeek V3)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 4. REAL-TIME WEB SEARCH
# ------------------------------------------------------------------------------
# Tavily Search API Key for real-time web research & citation retrieval
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 5. CLOUDINARY MEDIA HOSTING (Optional)
# ------------------------------------------------------------------------------
# Cloudinary credentials for permanent media hosting (fallback to data URIs if unset)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
